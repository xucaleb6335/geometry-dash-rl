# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Training output
runs/
logs/
*.pt
# the policies gdrl.tools.watch plays (configs/watch.yaml), ~1 MB each
!results/watch/*.pt

# C++ builds
build/
mod/build/
mod/build-*/
*.geode

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets / local settings
.env
*.log
.claude/settings.local.json

# Vim swap, undo and backup files
*.swp
*.un~
*~

# network visualizer: the standalone pages are rebuilt from the traces
# (python -m gdrl.tools.nn_trace export results/viz/<name>.trace.json.gz)
results/viz/*.html

# notes and reports not needed to recreate the bot (kept locally, not on GitHub)
LEARNING.md
PROGRESS.md
DEMON_PLAN.md
AGENTS.md
CLAUDE.md
progress_reports/
results/m8_mock.md
holistic_progress/*.md
AUTOPILOT.md
configs/gd_grief.yaml
configs/starts/grief.yaml
